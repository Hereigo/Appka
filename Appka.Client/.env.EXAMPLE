# Copy to .env.local and fill in the values from your cidaas tenant.
# .env.local is git-ignored; never commit real tenant values or secrets.
# A SINGLE_PAGE app is a public client: there is no client secret here.

VITE_CIDAAS_AUTHORITY=https://EXAMPLE-TENANT.cidaas.eu
VITE_CIDAAS_CLIENT_ID=YOUR-SPA-CLIENT-ID

# Optional. Defaults to "openid profile email roles".
# VITE_CIDAAS_SCOPE=openid profile email roles
